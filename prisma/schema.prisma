// ============================================================
// TMail Web — Prisma Schema
// ============================================================
// IMPORTANT: This schema was hand-written based on the known
// existing database structure. On first VPS deployment, run:
//   npx prisma db pull
// to sync with the real column types and constraints.
// DO NOT run prisma migrate — the DB already exists.
// Use prisma db push ONLY if you need to add new columns.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model admins {
  id            Int          @id @default(autoincrement())
  email         String       @unique
  password_hash String
  role          String?      @default("generator_admin")
  is_superadmin Boolean?     @default(false)
  created_at    DateTime?    @default(now())
  
  audit_logs       audit_logs[]
  generated_emails generated_emails[] @relation("AdminGeneratedEmails")
}

model buyers {
  id               Int                @id @default(autoincrement())
  username         String             @unique
  created_at       DateTime?          @default(now())
  is_active        Boolean?           @default(true)
  
  generated_emails generated_emails[]
}

model generated_emails {
  id              Int              @id @default(autoincrement())
  buyer_id        Int?
  generated_email String           @unique
  password_hash   String
  is_active       Boolean?         @default(true)
  created_by      Int?             // admin id who created
  created_at      DateTime?        @default(now())
  
  buyer           buyers?          @relation(fields: [buyer_id], references: [id])
  admin           admins?          @relation("AdminGeneratedEmails", fields: [created_by], references: [id])
  inbox_messages  inbox_messages[]
  otp_cache       otp_cache[]
}

model inbox_messages {
  id                  Int              @id @default(autoincrement())
  generated_email_id  Int
  sender              String?
  recipient           String?
  subject             String?
  raw_body            String?
  otp_code            String?
  received_at         DateTime?        @default(now())
  
  generated_email     generated_emails @relation(fields: [generated_email_id], references: [id])
}

model otp_cache {
  id                  Int              @id @default(autoincrement())
  generated_email_id  Int              @unique
  latest_otp          String?
  source              String?
  updated_at          DateTime?        @updatedAt
  
  generated_email     generated_emails @relation(fields: [generated_email_id], references: [id])
}

model audit_logs {
  id           Int       @id @default(autoincrement())
  admin_id     Int
  action       String
  target_email String?
  created_at   DateTime? @default(now())
  
  admin        admins    @relation(fields: [admin_id], references: [id])
}
